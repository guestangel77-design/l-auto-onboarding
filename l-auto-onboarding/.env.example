# 내 PC에서 실행할 때: 이 파일을 복사해서 이름을 .env 로 바꾸고 키를 넣으세요.
# .env 파일은 절대 다른 사람에게 보내거나 제출 파일·GitHub에 넣지 마세요.
# 키가 하나도 없어도 샘플1·2로 시연 모드 체험이 가능합니다.

# Claude API 키 (console.anthropic.com) - 서류 인식
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# 국세청 사업자등록정보 API 일반 인증키 (data.go.kr) - 휴·폐업, 과세유형, 진위확인
NTS_API_KEY=

# 도로명주소 검색 API 승인키 (business.juso.go.kr) - 우편번호 자동 조회
JUSO_API_KEY=
